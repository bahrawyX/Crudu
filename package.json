{
  "name": "crudu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Adaptive typing trainer that targets the transitions between keys, not the keys.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "words": "node scripts/build-wordlists.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.18.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
